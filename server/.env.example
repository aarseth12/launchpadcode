# Copy this file to server/.env and fill in your key:  cp .env.example .env
# The server reads server/.env every time it starts. server/.env is git-ignored, so the key never gets committed.
# A real environment variable (e.g.  ANTHROPIC_API_KEY=sk-ant-... npm start) takes priority over this file.

# Turns on the AI coach and drill hints. Get a key at https://console.anthropic.com/settings/keys
# Leave it out and everything else still works (drills fall back to built-in hints).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Docker images used for the sandboxes.
# FTC_PY_IMAGE=python:3-slim
# FTC_SANDBOX_IMAGE=eclipse-temurin:17-jre

# Optional: set to "none" to run student code WITHOUT the Docker sandbox (local development only).
# FTC_SANDBOX=none
